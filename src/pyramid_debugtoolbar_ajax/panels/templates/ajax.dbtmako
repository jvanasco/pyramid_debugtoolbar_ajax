<h4>Request HotLink</h4>

<%
	replay_path = request.path_qs
	# A path beginning with two slashes can select a different host.
	is_local_path = request.path.startswith("/") and not request.path.startswith("//")
	can_replay_post = request.charset == "UTF-8" and (
	    request.content_type == "application/x-www-form-urlencoded"
	    or (not request.content_type and request.content_length == 0)
	)
%>

% if not is_local_path:
	<p>Replay requires a local request path.</p>
% elif request.method == 'GET':
	<div class="alert alert-info">
		<h5>
			<i class="glyphicon glyphicon-info-sign"></i> `GET` request.  Replay Supported
		</h5>
		<p>
			<a
				href="${replay_path | n,h}"
				target="_blank" rel="noopener"
				class="btn btn-info"
			>
				<i class="glyphicon glyphicon-play-circle"></i> Replay Request (new window)
			</a>
		</p>
		<h5>
			Replay Data
		</h5>
		<table class="table table-striped table-condensed">
			<tr>
				<td>base url</td>
				<td>${request.host_url | n,h}</td>
			</tr>
			<tr>
				<td>full url</td>
				<td>${replay_path | n,h}</td>
			</tr>
			<tr>
				<td>request.path</td>
				<td>${request.path | n,h}</td>
			</tr>
			% for (k, v) in request.GET.items():
				<tr>
					<td>GET: ${k | n,h}</td>
					<td>${v | n,h}</td>
				</tr>
			% endfor
		</table>
	</div>
% elif request.method == 'POST' and can_replay_post:
	<div class="alert alert-danger">
		<h5>
			<i class="glyphicon glyphicon-warning-sign"></i> `POST` request. Form Replay Supported
		</h5>
		<p>
			<em>You can edit the form fields below. The original CSRF token may have expired.</em>
		</p>
		<form action="${replay_path | n,h}" method="POST" accept-charset="UTF-8" target="_blank" rel="noopener" role="form">
			<p>
				<button
					type="submit"
					class="btn btn-info"
				>
					<i class="glyphicon glyphicon-play-circle"></i> Replay Request (new window)
				</button>
			</p>

			<h5>
				Replay Data
			</h5>
			<table class="table table-striped table-condensed">
				<tr>
					<td>base url</td>
					<td>${request.host_url | n,h}</td>
				</tr>
				<tr>
					<td>full url</td>
					<td>${replay_path | n,h}</td>
				</tr>
				<tr>
					<td>request.path</td>
					<td>${request.path | n,h}</td>
				</tr>
				% for (k, v) in request.GET.items():
					<tr>
						<td>GET: ${k | n,h}</td>
						<td>${v | n,h}</td>
					</tr>
				% endfor
				% for (k, v) in request.POST.items():
					<tr>
						<td>POST: ${k | n,h}</td>
						<td>
							<input
								type="text"
								name="${k | n,h}"
								value="${v | n,h}"
								class="form-control"
							/>
						</td>
					</tr>
				% endfor
				<input type="submit" value="submit replay">
			</table>
		</form>
	</div>
% elif request.method == 'POST':
	<p>POST replay supports only UTF-8 URL-encoded form data.</p>
% else:
	<p>
		unsupported `request.method` (${request.method | n,h})
	</p>
% endif
